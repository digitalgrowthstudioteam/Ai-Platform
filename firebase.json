{
  "hosting": {
    "public": "frontend/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/campaigns/**",
        "destination": "/campaigns.html"
      },
      {
        "source": "/dashboard/campaign-plans/**",
        "destination": "/dashboard/campaign-plans/placeholder.html"
      },
      {
        "source": "/dashboard/campaign_plans/**",
        "destination": "/dashboard/campaign-plans/placeholder.html"
      },
      {
        "source": "/pay-quotation/**",
        "destination": "/pay-quotation/placeholder.html"
      },
      {
        "source": "/settings/admin/quotations/**",
        "destination": "/settings/admin/quotations/placeholder.html"
      },
      {
        "source": "/app/dashboard/products/new",
        "destination": "/app/dashboard/products/new.html"
      },
      {
        "source": "/app/dashboard/products/*/**",
        "destination": "/app/dashboard/products/placeholder.html"
      },
      {
        "source": "/app/dashboard/products/*",
        "destination": "/app/dashboard/products/placeholder.html"
      },
      {
        "source": "/app/dashboard/orders/*/**",
        "destination": "/app/dashboard/orders/placeholder.html"
      },
      {
        "source": "/app/dashboard/orders/*",
        "destination": "/app/dashboard/orders/placeholder.html"
      },
      {
        "source": "/app/store/*/products/**",
        "destination": "/app/store/placeholder/products/sample.html"
      },
      {
        "source": "/app/store/*/order/**",
        "destination": "/app/store/placeholder/order/sample.html"
      },
      {
        "source": "/app/store/*/cart/**",
        "destination": "/app/store/placeholder/cart.html"
      },
      {
        "source": "/app/store/*/cart",
        "destination": "/app/store/placeholder/cart.html"
      },
      {
        "source": "/app/store/*/checkout/**",
        "destination": "/app/store/placeholder/checkout.html"
      },
      {
        "source": "/app/store/*/checkout",
        "destination": "/app/store/placeholder/checkout.html"
      },
      {
        "source": "/app/store/*/account/**",
        "destination": "/app/store/placeholder/account.html"
      },
      {
        "source": "/app/store/*/account",
        "destination": "/app/store/placeholder/account.html"
      },
      {
        "source": "/app/store/**",
        "destination": "/app/store/placeholder.html"
      }
    ],
    "headers": [
      {
        "source": "/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
