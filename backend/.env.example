# =============================================
# Digital Growth Studio — Backend Environment
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── App ──────────────────────────────────────
APP_ENV=development
APP_NAME=Digital Growth Studio
APP_VERSION=1.0.0
DEBUG=true

# ── Server ───────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Database (Supabase PostgreSQL) ───────────
# Get this from Supabase Dashboard → Settings → Database → Connection string
# Use the "URI" format with asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Firebase ─────────────────────────────────
FIREBASE_PROJECT_ID=digital-growth-studio
FIREBASE_PRIVATE_KEY_PATH=./firebase-service-account.json

# ── Meta API (Phase 4) ──────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/meta/callback
META_API_VERSION=v21.0

# ── Encryption ───────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Redis (for Celery) ───────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Razorpay (Phase 9) ──────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── AI (Phase 8) ────────────────────────────
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ── Sync ─────────────────────────────────────
SYNC_COOLDOWN_MINUTES=15
INITIAL_SYNC_DAYS=30
